    function renderApp() {
      const container = document.getElementById("contentList");
      let markup = "";

      channelSections.forEach(section => {
        markup += `
          <div class="section-title ${section.type}">${section.title}</div>
          <div class="channels-list">
        `;

        section.items.forEach(ch => {
          markup += `
            <a href="${ch.url}" target="_blank" rel="noopener noreferrer" class="channel-card" data-url="${ch.url}">
