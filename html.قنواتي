<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>دليل القنوات والمجموعات الرسمية</title>
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(18, 24, 38, 0.85);
      --border: rgba(0, 229, 255, 0.18);
      --accent: #00e5ff;
      --accent-glow: rgba(0, 229, 255, 0.35);
      --text: #e2e8f0;
      --text-muted: #94a3b8;
      --wa-color: #25d366;
      --yt-color: #ff0000;
      --tg-color: #229ed9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: radial-gradient(circle at top, #131c31 0%, var(--bg) 100%);
      color: var(--text);
      min-height: 100vh;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 680px;
    }

    header {
      text-align: center;
      margin-bottom: 24px;
    }

    header h1 {
      font-size: 1.8rem;
      color: var(--accent);
      text-shadow: 0 0 12px var(--accent-glow);
    }

    header p {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 6px;
    }

    .section-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 22px 0 12px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title.wa { color: var(--wa-color); }
    .section-title.yt { color: var(--yt-color); }
    .section-title.tg { color: var(--tg-color); }

    .channels-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 15px;
    }

    .channel-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      backdrop-filter: blur(10px);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      text-decoration: none;
      color: inherit;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
      cursor: pointer;
    }

    .channel-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      box-shadow: 0 6px 20px var(--accent-glow);
    }

    .channel-info {
      display: flex;
      align-items: center;
      gap: 14px;
      overflow: hidden;
    }

    .icon-badge {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .icon-badge svg {
      width: 28px;
      height: 28px;
      fill: #fff;
    }

    .badge-wa {
      background: linear-gradient(135deg, #25d366, #128c7e);
      box-shadow: 0 0 12px rgba(37, 211, 102, 0.3);
    }

    .badge-yt {
      background: linear-gradient(135deg, #ff0000, #b20710);
      box-shadow: 0 0 12px rgba(255, 0, 0, 0.3);
    }

    .badge-tg {
      background: linear-gradient(135deg, #229ed9, #0088cc);
      box-shadow: 0 0 12px rgba(34, 158, 217, 0.3);
    }

    .channel-meta {
      overflow: hidden;
    }

    .channel-name {
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .channel-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 4px;
      direction: ltr;
      text-align: right;
    }

    .btn-action {
      flex-shrink: 0;
      padding: 10px 16px;
      border-radius: 9px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #fff;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: none;
    }

    .btn-wa { background: #128c7e; box-shadow: 0 0 10px rgba(18, 140, 126, 0.4); }
    .btn-yt { background: #cc0000; box-shadow: 0 0 10px rgba(204, 0, 0, 0.4); }
    .btn-tg { background: #0088cc; box-shadow: 0 0 10px rgba(0, 136, 204, 0.4); }

    .lock-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
    }

    .lock-box {
      background: #111827;
      border: 1px solid var(--accent);
      border-radius: 16px;
      padding: 24px;
      max-width: 420px;
      text-align: center;
      box-shadow: 0 0 25px var(--accent-glow);
    }

    .lock-box h3 {
      color: #fff;
      font-size: 1.25rem;
      margin-bottom: 10px;
    }

    .lock-box p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .btn-lock {
      background: linear-gradient(135deg, #00e5ff, #0077b6);
      color: #0b0f19;
      font-weight: bold;
      border: none;
      padding: 11px 22px;
      border-radius: 8px;
      font-size: 0.95rem;
      cursor: pointer;
      width: 100%;
    }
  </style>
</head>
<body>

